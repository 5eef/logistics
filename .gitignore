# Secrets et configurations locales
.env
.env.*
!.env.example
!.env.production.example
!.env.staging.example
!backend-new/.env.staging.example
!frontend/.env.staging.example
backend-new/.env
backend-new/.env.staging
frontend/.env
frontend/.env.staging

# Certificats TLS locaux et sauvegardes reelles
.docker/tls/*
!.docker/tls/.gitignore
backups/mysql/*
!backups/mysql/.gitignore

# Dépendances
backend-new/vendor/
frontend/node_modules/

# Base SQLite locale
backend-new/database/*.sqlite
backend-new/database/*.sqlite-*

# Laravel runtime
backend-new/storage/logs/*
backend-new/storage/framework/cache/*
backend-new/storage/framework/sessions/*
backend-new/storage/framework/views/*
backend-new/bootstrap/cache/*.php
backend-new/.phpunit.result.cache
backend-new/public/storage

# Build frontend
frontend/dist/

# Fichiers temporaires
*.log
.DS_Store
Thumbs.db
.copilot-azure/
.vscode/
.idea/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/

# Outils locaux
logistics-final/
