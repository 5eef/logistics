{
	admin off
	servers {
		protocols h1 h2 h3
	}
}

app.example.com {
	tls {
		protocols tls1.2 tls1.3
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.example.com wss://api.example.com"
		-Server
	}
	reverse_proxy frontend:8080
}

api.example.com {
	tls {
		protocols tls1.2 tls1.3
	}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	request_body {
		max_size 3MB
	}
	@reverb path /app/* /apps/*
	reverse_proxy @reverb reverb:8080
	reverse_proxy backend:8080
}
