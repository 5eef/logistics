# Copy this file to an ignored local path after generating a certificate with:
# mkcert -cert-file .docker/tls/logistics.local.pem -key-file .docker/tls/logistics.local-key.pem logistics.local api.logistics.local mail.logistics.local
# Then mount the copied Caddyfile instead of Caddyfile.staging in a local Compose override.
{
	admin off
	auto_https disable_redirects
}

http://logistics.local, http://api.logistics.local, http://mail.logistics.local {
	redir https://{host}{uri} permanent
}

https://logistics.local {
	tls /etc/caddy/tls/logistics.local.pem /etc/caddy/tls/logistics.local-key.pem {
		protocols tls1.2 tls1.3
	}
	reverse_proxy frontend:8080
}

https://api.logistics.local {
	tls /etc/caddy/tls/logistics.local.pem /etc/caddy/tls/logistics.local-key.pem {
		protocols tls1.2 tls1.3
	}
	@reverb path /app/* /apps/*
	reverse_proxy @reverb reverb:8080
	reverse_proxy backend:8080
}

https://mail.logistics.local {
	tls /etc/caddy/tls/logistics.local.pem /etc/caddy/tls/logistics.local-key.pem {
		protocols tls1.2 tls1.3
	}
	reverse_proxy mailpit:8025
}
