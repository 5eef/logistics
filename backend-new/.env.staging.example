# The canonical staging template is ../.env.staging.example and is consumed by
# docker-compose.staging.yml. This file documents backend-only deployment keys.
APP_ENV=staging
APP_DEBUG=false
APP_KEY=CHANGE_ME
APP_URL=https://api.logistics.local
FRONTEND_URL=https://logistics.local
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=logistics_school
DB_USERNAME=logistics_app
DB_PASSWORD=CHANGE_ME
SESSION_DRIVER=database
SESSION_DOMAIN=.logistics.local
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=logistics.local
CORS_ALLOWED_ORIGINS=https://logistics.local
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
PHONE_VERIFICATION_ENABLED=false
PHONE_VERIFICATION_DRIVER=fail_closed
REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=api.logistics.local
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_INTERNAL_HOST=reverb
REVERB_INTERNAL_PORT=8080
REVERB_INTERNAL_SCHEME=http
REVERB_ALLOWED_ORIGINS=logistics.local
LOG_CHANNEL=stderr
LOG_LEVEL=info
