APP_NAME=Logistics
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
PHONE_VERIFICATION_ENABLED=false
PHONE_VERIFICATION_DRIVER=fail_closed
PHONE_PROVIDER=
PHONE_PROVIDER_KEY=
PHONE_PROVIDER_SECRET=
CORS_ALLOWED_ORIGINS=https://app.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=your-managed-database-host
DB_PORT=3306
DB_DATABASE=logistics
DB_USERNAME=logistics_app
DB_PASSWORD=replace-with-a-secret

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.example.com

FILESYSTEM_DISK=public
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-user
MAIL_PASSWORD=replace-with-mail-secret
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=replace-with-generated-id
REVERB_APP_KEY=replace-with-generated-public-key
REVERB_APP_SECRET=replace-with-generated-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=ws.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_INTERNAL_HOST=127.0.0.1
REVERB_INTERNAL_PORT=8080
REVERB_INTERNAL_SCHEME=http
REVERB_ALLOWED_ORIGINS=app.example.com

BACKUP_RETENTION_DAYS=14
BACKUP_PATH=/var/backups/logistics
