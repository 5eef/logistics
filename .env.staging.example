COMPOSE_PROJECT_NAME=logistics-staging

# Local-only endpoints. Add these names to the local hosts file.
STAGING_FRONTEND_HOST=logistics.local
STAGING_API_HOST=api.logistics.local
STAGING_MAIL_HOST=mail.logistics.local
STAGING_HTTPS_PORT=443
STAGING_HTTP_PORT=80

# Generate real local values with scripts/init-staging.ps1. Never commit them.
APP_KEY=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME
REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME

APP_NAME="Logistics School"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://api.logistics.local
FRONTEND_URL=https://logistics.local
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=logistics_school
DB_USERNAME=logistics_app

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.logistics.local
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=logistics.local
CORS_ALLOWED_ORIGINS=https://logistics.local

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public

LOG_CHANNEL=stderr
LOG_LEVEL=info

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@logistics.local
MAIL_FROM_NAME="Logistics School"

PHONE_VERIFICATION_ENABLED=false
PHONE_VERIFICATION_DRIVER=fail_closed
PHONE_PROVIDER=
PHONE_PROVIDER_KEY=
PHONE_PROVIDER_SECRET=

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=api.logistics.local
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_INTERNAL_HOST=reverb
REVERB_INTERNAL_PORT=8080
REVERB_INTERNAL_SCHEME=http
REVERB_ALLOWED_ORIGINS=logistics.local

VITE_API_URL=https://api.logistics.local/api
VITE_REQUEST_TIMEOUT_MS=15000
VITE_DEMO_MODE=false
VITE_REVERB_HOST=api.logistics.local
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

BACKUP_RETENTION_DAYS=14
BACKUP_PATH=backups/mysql

# Required only by integrated staging tests/seeders; use fictitious accounts.
STAGING_TEST_EMAIL=staging.sender@example.test
STAGING_TEST_PASSWORD=CHANGE_ME
STAGING_TEST_NEW_PASSWORD=CHANGE_ME
